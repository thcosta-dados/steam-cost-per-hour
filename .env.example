# Template of the environment variables used by the project.
# Copy this file to .env and fill in the values. Never commit .env.

# Steam Web API key (free, from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Users to collect: '<17-digit SteamID64>:<nickname>', several separated by ';'
# (only people who agreed). SteamIDs are stored in the database only as a hash;
# the nickname is shown in the dashboard. Example format: 7656119XXXXXXXXXX:nickname
STEAM_USERS=
# Secret key used to hash the SteamID (any long random text).
# Must be the same in every environment, or the same person becomes a different user.
STEAM_ID_HASH_KEY=

# Database connection.
# Local Docker (.env): keep host "db" and port 5432 (the app talks to the db container).
# From Windows (pgAdmin, DBeaver, Power BI) use localhost:5433 instead.
# Supabase (.env.cloud): values from Connect > Session pooler, database "postgres",
# user "postgres.<project-ref>", and POSTGRES_SSLMODE=require.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=steam
POSTGRES_USER=steam
POSTGRES_PASSWORD=
# Optional: "require" for the cloud database. Empty or missing = "prefer" (local).
POSTGRES_SSLMODE=
