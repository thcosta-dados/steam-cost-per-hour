# Template of the environment variables used by the project.
# Copy this file to .env and fill in the values. Never commit .env.

# Steam Web API key (free, from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Your SteamID64 (17 digits). Only stored in the database as a hash.
STEAM_ID=
# Nickname shown in the dashboard
STEAM_NICKNAME=
# Secret key used to hash the SteamID (any long random text)
STEAM_ID_HASH_KEY=

# Database connection.
# Local Docker: keep host "db" and port 5432 (the app talks to the db container).
# From Windows (pgAdmin, DBeaver, Power BI) use localhost:5433 instead.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=steam
POSTGRES_USER=steam
POSTGRES_PASSWORD=
