# Instrucoes locais do assistente de codigo (nao versionar)
CLAUDE.md
CLAUDE.local.md

# Credentials: real values live only in .env files (.env = local, .env.cloud = Supabase).
# Any .env* file is ignored; only the template is versioned.
.env*
!.env.example

# Purchase history saved from the browser (personal data, never commit)
*.html
# Exception: fictional history used by the tests
!tests/fixtures/*.html

# Power BI project: imported data cache and local settings (only the report definition is versioned)
**/.pbi/cache.abf
**/.pbi/localSettings.json

# Python temporary files
__pycache__/
*.pyc
.pytest_cache/
.venv/
