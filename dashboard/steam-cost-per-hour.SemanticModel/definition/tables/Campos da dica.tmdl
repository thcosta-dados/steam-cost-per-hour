/// Linhas da dica do jogo, no estilo de atributos de item.
table 'Campos da dica'
	lineageTag: ddfc7808-fd97-4ae1-b15f-f22dcdf94e0b

	measure 'Valor da dica' =
			SWITCH ( SELECTEDVALUE ( 'Campos da dica'[Ordem] ),
			    1, [Horas texto],
			    2, [Custo por hora do jogo],
			    3, [Selo],
			    4, [Paguei texto],
			    5, [Extras texto],
			    6, [Como consegui],
			    7, [Data da compra] )
		lineageTag: 1cb45baf-cff2-406b-864b-5ea44e713d8e

	measure 'Cor do valor da dica' = IF ( SELECTEDVALUE ( 'Campos da dica'[Ordem] ) = 3, [Cor do selo], "#E6EDF3" )
		lineageTag: 1cc72e21-85c3-47fb-8989-6ca51807c704

	column Ordem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0455c0da-eb1a-41ae-b8b2-b6366eca5645
		summarizeBy: none
		sourceColumn: Ordem

	column Campo
		dataType: string
		lineageTag: 6038ceac-e620-43e3-b190-a3d6f66b6d78
		summarizeBy: none
		sourceColumn: Campo
		sortByColumn: Ordem

	partition 'Campos da dica' = m
		mode: import
		source =
				let
				    Result = #table(type table [Ordem = Int64.Type, Campo = text], {{1, "Horas"}, {2, "Por hora"}, {3, "Selo"}, {4, "Paguei"}, {5, "Dentro do jogo"}, {6, "Como consegui"}, {7, "Comprei em"}})
				in
				    Result

	annotation PBI_ResultType = Table

