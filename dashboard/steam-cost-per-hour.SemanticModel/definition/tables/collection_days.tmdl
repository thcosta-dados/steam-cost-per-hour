/// Play days covered by a collection (view public.collection_days): axis of the daily charts, so a day with a collection and no play shows 0.
table collection_days
	lineageTag: bc8bf7aa-a99e-4099-83b2-eb6c26f82b48

	column play_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 6e4ba7fc-8dc4-411e-b0d3-faea1598a2cb
		summarizeBy: none
		sourceColumn: play_date

		annotation UnderlyingDateTimeDataType = Date

	column weekday_number
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d5540a1e-765b-40a5-b5be-1e6d5bfeaddf
		summarizeBy: none
		sourceColumn: weekday_number

	column weekday_short
		dataType: string
		lineageTag: 6b5dd614-3ecf-4b71-8510-0964b3a11b1d
		summarizeBy: none
		sourceColumn: weekday_short
		sortByColumn: weekday_number

	column weekday_name
		dataType: string
		lineageTag: edc1cf6f-ba9f-4dae-8603-81cf5ff815d7
		summarizeBy: none
		sourceColumn: weekday_name
		sortByColumn: weekday_number

	partition collection_days = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(DatabaseServer, DatabaseName),
				    Days = Source{[Schema = "public", Item = "collection_days"]}[Data],
				    // One row per day for all users: the "one" side of the relationship with daily_playtime
				    Distinct = Table.Distinct(Table.SelectColumns(Days, {"play_date"})),
				    Typed = Table.TransformColumnTypes(Distinct, {{"play_date", type date}}),
				    WeekdayNumber = Table.AddColumn(Typed, "weekday_number", each Date.DayOfWeek([play_date], Day.Monday) + 1, Int64.Type),
				    WeekdayShort = Table.AddColumn(WeekdayNumber, "weekday_short", each {"seg", "ter", "qua", "qui", "sex", "sáb", "dom"}{[weekday_number] - 1}, type text),
				    WeekdayName = Table.AddColumn(WeekdayShort, "weekday_name", each {"segunda", "terça", "quarta", "quinta", "sexta", "sábado", "domingo"}{[weekday_number] - 1}, type text)
				in
				    WeekdayName

	annotation PBI_ResultType = Table

