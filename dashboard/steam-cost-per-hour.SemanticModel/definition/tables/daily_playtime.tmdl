/// Hours played per play day and game (view public.daily_playtime, spec rules 11 to 13).
table daily_playtime
	lineageTag: ef6f0657-ce54-412c-b3b6-c2544310bdd7

	measure 'Horas jogadas' = SUM ( daily_playtime[hours_played] )
		formatString: #,0.0
		lineageTag: a623bec7-0f34-419d-ab62-33f8abc84c76

	/// Hours per collection day: 0 on a day with a collection and no play (axis: collection_days).
	measure 'Horas jogadas no dia' = [Horas jogadas] + 0
		formatString: #,0.0
		lineageTag: 99cbfb03-df4a-408c-86e6-a25093f95fe4

	/// Days with play in the filter context.
	measure 'Dias com jogo' = DISTINCTCOUNT ( daily_playtime[play_date] ) + 0
		formatString: 0
		lineageTag: 8fb4047d-5b70-4263-892f-831136a47004

	measure 'Jogos que abri' = DISTINCTCOUNT ( daily_playtime[game_key] ) + 0
		formatString: 0
		lineageTag: 1a0ef4cd-c1a0-4a47-8679-17b62fafd8d9

	measure 'Melhor dia horas' =
			MAXX ( ADDCOLUMNS ( VALUES ( collection_days[play_date] ), "@h",
			    CALCULATE ( SUM ( daily_playtime[hours_played] ), daily_playtime[days_covered] = 1 ) ), [@h] )
		formatString: 0.0
		lineageTag: 913e91b2-9332-4cfa-807e-96664a17be87

	measure 'Melhor dia texto' = VAR h = [Melhor dia horas] RETURN IF ( ISBLANK ( h ), "0 h", FORMAT ( h, "0.0" ) & " h" )
		lineageTag: 062e0f17-c5f3-4420-8c7d-73415ef06533

	measure 'Melhor dia frase' =
			VAR dias = ADDCOLUMNS ( VALUES ( collection_days[play_date] ), "@h", CALCULATE ( SUM ( daily_playtime[hours_played] ), daily_playtime[days_covered] = 1 ) )
			VAR topo = TOPN ( 1, FILTER ( dias, [@h] > 0 ), [@h], DESC, collection_days[play_date], DESC )
			RETURN IF ( ISEMPTY ( topo ), "nenhum dia com jogo", FORMAT ( MAXX ( topo, collection_days[play_date] ), "dddd, dd/mm/yyyy" ) )
		lineageTag: 10b761d6-65a0-411c-80ec-e0efd1329cbd

	/// Maior sequência de dias anotados seguidos com jogo; dia sem anotação não quebra nem soma
	measure 'Maior sequência de dias' =
			VAR jogados = FILTER ( VALUES ( collection_days[play_date] ), CALCULATE ( SUM ( daily_playtime[minutes_played] ) ) > 0 )
			VAR semJogo = FILTER ( ALLSELECTED ( collection_days[play_date] ), CALCULATE ( SUM ( daily_playtime[minutes_played] ) ) + 0 = 0 )
			VAR comQuebra = ADDCOLUMNS ( jogados, "@quebra", VAR d = collection_days[play_date] RETURN MAXX ( FILTER ( semJogo, collection_days[play_date] < d ), collection_days[play_date] ) )
			VAR grupos = GROUPBY ( comQuebra, [@quebra], "@dias", SUMX ( CURRENTGROUP (), 1 ) )
			RETURN MAXX ( grupos, [@dias] ) + 0
		formatString: 0
		lineageTag: c62ecd07-0fb3-4371-a687-213ba7953e9a

	measure 'Maior sequência texto' = VAR n = [Maior sequência de dias] RETURN n & IF ( n = 1, " dia", " dias" )
		lineageTag: f13a9614-69d5-44ca-b7b1-7a8a0efd9ac6

	measure 'Média por dia jogado' =
			AVERAGEX (
			    FILTER ( VALUES ( collection_days[play_date] ), CALCULATE ( SUM ( daily_playtime[hours_played] ), daily_playtime[days_covered] = 1 ) > 0 ),
			    CALCULATE ( SUM ( daily_playtime[hours_played] ), daily_playtime[days_covered] = 1 ) )
		formatString: 0.0
		lineageTag: b1a419ae-74aa-4091-9d94-d9716061269a

	measure 'Título do dia da semana' =
			VAR dias = ADDCOLUMNS ( VALUES ( collection_days[weekday_name] ), "@m", [Média por dia jogado] )
			VAR topo = TOPN ( 1, FILTER ( dias, NOT ISBLANK ( [@m] ) ), [@m], DESC )
			VAR nome = MAXX ( topo, collection_days[weekday_name] )
			RETURN IF ( ISEMPTY ( topo ), "Nenhum dia com jogo nesse período", UPPER ( LEFT ( nome, 1 ) ) & MID ( nome, 2, 20 ) & " é o meu dia: " & FORMAT ( MAXX ( topo, [@m] ), "0.0" ) & " h em média" )
		lineageTag: 710dfef1-79f7-491c-aea7-c961c2371d1d

	measure 'Título dos jogos do período' =
			VAR total = [Horas jogadas]
			VAR jogos = ADDCOLUMNS ( VALUES ( game_costs[name] ), "@h", [Horas jogadas] )
			VAR topo = TOPN ( 1, FILTER ( jogos, [@h] > 0 ), [@h], DESC )
			RETURN IF ( ISBLANK ( total ), "Nenhuma hora com esses filtros", MAXX ( topo, game_costs[name] ) & " ficou com " & FORMAT ( DIVIDE ( MAXX ( topo, [@h] ), total ), "0%" ) & " das minhas horas" )
		lineageTag: c089e942-286c-40f4-85b1-377caf2b9984

	measure 'Fatia do período' = DIVIDE ( [Horas jogadas], CALCULATE ( [Horas jogadas], ALLSELECTED ( game_costs ) ) )
		formatString: 0%
		lineageTag: b092bef4-d02a-4904-83b1-673d29e1a77a

	measure 'Dias anotados' = CALCULATE ( COUNTROWS ( collection_days ) ) + 0
		formatString: 0
		lineageTag: 06987ba3-25b3-4279-a3fc-d9c2d0e1025b

	measure 'Frase dos dias de jogo' = "em " & [Dias com jogo] & " de " & [Dias anotados] & " dias anotados"
		lineageTag: a89f078e-1481-43e0-b57b-55111debd520

	measure 'Título do gráfico diário' = "Quanto joguei em cada dia, desde " & FORMAT ( MIN ( collection_days[play_date] ), "dd/mm/yyyy" )
		lineageTag: 3730f9cb-e9ae-4c72-b2ce-cf036b6859e4

	measure 'Horas do período texto' = FORMAT ( [Horas jogadas] + 0, "#,0.0" ) & " h"
		lineageTag: 72c9bd18-f169-4dad-b43c-8fa00344e05d

	measure 'Título horas do período' = "Horas jogadas, " & [Frase dos dias de jogo]
		lineageTag: ef996761-8eee-4c34-b452-5f0f0e826efe

	measure 'Título melhor dia' = "Meu melhor dia: " & [Melhor dia frase]
		lineageTag: 18ac9ede-9254-4498-b32a-ad9074084efa

	measure 'Dias jogados' = DISTINCTCOUNT ( daily_playtime[play_date] )
		formatString: 0
		lineageTag: 1c3137c0-410c-4faf-90bf-032d3ffb90dd

	measure 'Cor do dia da semana' = IF ( [Média por dia jogado] = MAXX ( ALLSELECTED ( collection_days[weekday_short] ), [Média por dia jogado] ), "#FFC24B", "#3987E5" )
		lineageTag: c1433191-44db-4495-a3c0-30089eeaaf89

	measure 'Título dias anotados' = "Dias anotados desde " & FORMAT ( CALCULATE ( MIN ( collection_days[play_date] ), ALL ( collection_days ) ), "dd/mm/yyyy" ) & ", toda manhã"
		lineageTag: 8067876d-2d21-4f39-8c44-283a4d6674e2

	measure 'Dias anotados no total' = CALCULATE ( COUNTROWS ( collection_days ), ALL ( collection_days ) ) + 0
		formatString: 0
		lineageTag: 63338a6f-2236-44b8-967c-3bedebc7f601

	column user_id
		dataType: string
		isHidden
		lineageTag: 3d60e841-7df2-445f-953c-ade7a53f7630
		summarizeBy: none
		sourceColumn: user_id

	column app_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f223696b-567f-4c35-998b-ede147f900f2
		summarizeBy: none
		sourceColumn: app_id

	column name
		dataType: string
		lineageTag: f6a7ec9e-0c6e-4b8e-b410-6861a653d9c2
		summarizeBy: none
		sourceColumn: name

	column play_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: b3e937fb-7a12-43aa-a5fd-e035d1ae4509
		summarizeBy: none
		sourceColumn: play_date

		annotation UnderlyingDateTimeDataType = Date

	column days_covered
		dataType: int64
		formatString: 0
		lineageTag: aad36860-75f2-4cc5-a55f-30546899870d
		summarizeBy: none
		sourceColumn: days_covered

	column minutes_played
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 08d2675a-bd73-4c2f-891d-cad949ce65d0
		summarizeBy: none
		sourceColumn: minutes_played

	column hours_played
		dataType: double
		formatString: #,0.00
		lineageTag: 80f1139f-d530-4827-b00c-04d60d94f73d
		summarizeBy: none
		sourceColumn: hours_played

	/// Same key as game_costs[game_key]: the relationship that filters the days of one game.
	column game_key
		dataType: string
		isHidden
		lineageTag: fb44188d-6800-4f86-a91b-dcf5dab1f6de
		summarizeBy: none
		sourceColumn: game_key

	partition daily_playtime = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(DatabaseServer, DatabaseName),
				    Daily = Source{[Schema = "public", Item = "daily_playtime"]}[Data],
				    Selected = Table.SelectColumns(Daily, {"user_id", "app_id", "name", "play_date", "days_covered", "minutes_played", "hours_played", "game_key"}),
				    Typed = Table.TransformColumnTypes(Selected, {
				        {"app_id", Int64.Type}, {"play_date", type date}, {"days_covered", Int64.Type},
				        {"minutes_played", Int64.Type}, {"hours_played", type number}
				    })
				in
				    Typed

	annotation PBI_ResultType = Table

