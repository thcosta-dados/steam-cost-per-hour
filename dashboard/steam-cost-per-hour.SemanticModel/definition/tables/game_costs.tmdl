/// Cost per hour of each game (view public.game_costs). Labels translated to Portuguese in Power Query.
table game_costs
	lineageTag: bf85bb68-cd73-478d-90cb-92bdadf5e71a

	/// Value of licensed games never opened (spec, rule 9). Unknown values are blank and ignored by SUM (rule 18).
	measure 'Dinheiro parado' = CALCULATE ( SUM ( game_costs[game_value_brl] ), game_costs[hours_group] = "não jogado" )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: c893c9ba-a6dc-4117-bd3e-c2e8cbfc3175

	/// Value of games played for less than 1 hour (spec, rule 10).
	measure 'Valor em jogos mal começados' = CALCULATE ( SUM ( game_costs[game_value_brl] ), game_costs[hours_group] = "mal começado" )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: bb0eb698-c498-4d92-8c07-8347ed7083ed

	/// Licensed games without a purchase record or store price: out of the ranking and sums (spec, rule 18).
	measure 'Jogos sem valor conhecido' = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "sem valor conhecido" ) + 0
		formatString: 0
		lineageTag: dda9c777-cd73-48f8-a136-4deb179ae698

	/// Everything spent on Steam on games: game value + extra spending (DLCs, in-game purchases).
	measure 'Gasto total' = SUM ( game_costs[total_spend_brl] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: ba5bd1de-441c-47d7-9717-3c033faeee87

	/// Spending on games bought (value + extra), to compare with games without access cost.
	measure 'Gasto em jogos pagos' = CALCULATE ( SUM ( game_costs[total_spend_brl] ), game_costs[value_origin] = "pago" )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 1056a96a-de8c-4ac0-9192-bf821b44467e

	/// Money spent inside free games and games received without purchase (spec, rule 16).
	measure 'Gasto em jogos sem custo de acesso' = CALCULATE ( SUM ( game_costs[extra_spend_brl] ), game_costs[value_origin] IN { "gratuito", "sem compra na Steam" } )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: cb7cd97b-d6b8-41ab-becc-83c9f45733b1

	measure 'Nível dos dados' = IF ( CALCULATE ( COUNTROWS ( game_costs ), game_costs[purchase_history_loaded] = TRUE () ) > 0, "Completo", "Estimado" )
		lineageTag: aa6c2bc1-b18f-4866-b9bb-94d45963159c

	measure 'Data da compra' = VAR purchase_date = MIN ( game_costs[first_purchase_date] ) RETURN IF ( ISBLANK ( purchase_date ), "não comprei", FORMAT ( purchase_date, "dd/mm/yyyy" ) )
		lineageTag: fd98d026-a2ac-413b-8578-8a493f714f25

	/// Cost per hour of one game, as text: "nunca abri" for 0 hours, "sem preço" for an unknown value (rules 9 and 18).
	measure 'Custo por hora do jogo' = VAR cost = SUM ( game_costs[cost_per_hour_brl] ) RETURN IF ( ISBLANK ( cost ), IF ( SUM ( game_costs[minutes_played] ) = 0, "nunca abri", "sem preço" ), "R$" & UNICHAR ( 160 ) & FORMAT ( cost, "#,0.00" ) )
		lineageTag: 44d9e389-c6b4-49ae-9e18-94d7665ad96a

	/// Manchete do ranking: o jogo pago (1 h ou mais) que custou menos por hora
	measure 'Título do ranking' =
			VAR elegiveis = FILTER ( game_costs, game_costs[hours_group] = "jogado" && game_costs[value_origin] IN { "pago", "estimado" } )
			VAR melhor = TOPN ( 1, elegiveis, game_costs[cost_per_hour_brl], ASC )
			RETURN IF ( ISEMPTY ( melhor ), "Nenhum jogo pago com esse filtro",
			    MAXX ( melhor, game_costs[name] ) & " foi o jogo que mais valeu a pena: " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( melhor, game_costs[cost_per_hour_brl] ), "#,0.00" ) & " por hora" )
		lineageTag: ef820eca-795b-48c0-ac50-c3ff57bd067d

	/// Spec rule 25: total spending on paid (or estimated) games divided by their hours, 0 h games included.
	measure 'Custo médio por hora (jogos pagos)' = DIVIDE ( CALCULATE ( SUM ( game_costs[total_spend_brl] ), game_costs[value_origin] IN { "pago", "estimado" } ), CALCULATE ( SUM ( game_costs[minutes_played] ), game_costs[value_origin] IN { "pago", "estimado" } ) / 60 )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 74ae5d52-239c-4fff-95ba-e1e870917b40

	/// Money parked with the number of games, so "R$ 0,00" does not look like an error.
	measure 'Dinheiro parado com contagem' = VAR games = CALCULATE ( COUNTROWS ( game_costs ), game_costs[hours_group] = "não jogado", game_costs[game_value_brl] > 0 ) + 0 RETURN "R$" & UNICHAR ( 160 ) & FORMAT ( [Dinheiro parado] + 0, "#,0.00" ) & " · " & games & IF ( games = 1, " jogo", " jogos" )
		lineageTag: e1829d89-db9e-4003-a67b-db2c7acfd067

	/// Value of paid games played for less than 1 hour, with the number of games.
	measure 'Mal começados com contagem' = VAR games = CALCULATE ( COUNTROWS ( game_costs ), game_costs[hours_group] = "mal começado", game_costs[game_value_brl] > 0 ) + 0 RETURN "R$" & UNICHAR ( 160 ) & FORMAT ( [Valor em jogos mal começados] + 0, "#,0.00" ) & " · " & games & IF ( games = 1, " jogo", " jogos" )
		lineageTag: b0caad86-a7b6-4d0f-b5e8-2cd2b0c904aa

	/// Context line of the home page: total spending, what cost per hour means and the last collection.
	measure 'Contexto do início' = "Gasto total na Steam: " & "R$" & UNICHAR ( 160 ) & FORMAT ( [Gasto total], "#,0.00" ) & "   ·   Custo por hora = (valor do jogo + gasto extra) ÷ horas jogadas   ·   Última coleta: " & FORMAT ( MAX ( game_costs[last_snapshot_date] ), "dd/mm/yyyy" )
		lineageTag: 655deefc-5b8c-4f9e-a357-10dc6e3a7094

	measure 'Horas na biblioteca' = DIVIDE ( SUM ( game_costs[minutes_played] ), 60 )
		formatString: #,0" h"
		lineageTag: edf9bf1d-b048-4501-b7f3-1b5fa7913a68

	/// Horas para ler: minutos abaixo de 1 h, uma casa abaixo de 100 h, inteiro acima
	measure 'Horas texto' =
			VAR m = SUM ( game_costs[minutes_played] )
			VAR h = m / 60
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( m ) || m = 0, "0 h",
			    m < 60, FORMAT ( m, "0" ) & " min",
			    h < 100, FORMAT ( h, "#,0.0" ) & " h",
			    FORMAT ( h, "#,0" ) & " h" )
		lineageTag: ae6306e3-fc35-47ca-8e21-ed77fdb5e757

	measure 'Dias inteiros' = INT ( DIVIDE ( [Horas na biblioteca], 24 ) )
		formatString: #,0
		lineageTag: caa2db74-e505-4678-befb-26f3a347149e

	measure 'Frase dias inteiros' = "dá " & FORMAT ( [Dias inteiros], "#,0" ) & " dias inteiros"
		lineageTag: 7f38ca60-9931-41c6-84b0-b589598d6b18

	measure 'Jogos na conta' = COUNTROWS ( game_costs ) + 0
		formatString: 0
		lineageTag: e02ab42f-9a8a-44b9-848e-fff18edc53c4

	measure 'Frase da biblioteca' =
			VAR pagos = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "pago" ) + 0
			VAR gratis = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "gratuito" ) + 0
			VAR semCompra = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "sem compra na Steam" ) + 0
			VAR outros = [Jogos na conta] - pagos - gratis - semCompra
			RETURN pagos & " pagos, " & gratis & " grátis, " & semCompra & " sem compra" & IF ( outros > 0, ", " & outros & " estimados ou sem preço", "" )
		lineageTag: 46b79233-e1f1-4389-8b90-778c40c94571

	measure 'Gasto total texto' = VAR v = [Gasto total] RETURN IF ( ISBLANK ( v ), "sem preço", "R$" & UNICHAR ( 160 ) & FORMAT ( v, "#,0.00" ) )
		lineageTag: 62c12da5-8692-47f7-b4f6-302b0c94ef12

	measure 'Custo médio texto' = "R$" & UNICHAR ( 160 ) & FORMAT ( [Custo médio por hora (jogos pagos)] + 0, "#,0.00" )
		lineageTag: cd47d17b-777f-4eef-8ec2-7a0dd39d1a6b

	measure 'Tem estimado' = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "estimado" ) > 0
		lineageTag: f5bc5d38-1bc3-414a-91ed-87011c7c5953

	measure 'Frase do gasto total' = IF ( [Tem estimado], "pago e estimado pela loja", "valor pago, do meu histórico" )
		lineageTag: 402c3196-eb73-439a-972a-ef5adbc855a5

	measure 'Frase do custo médio' = IF ( [Tem estimado], "média dos pagos e estimados", "média dos jogos pagos" )
		lineageTag: 6b102382-4b1c-4d7a-be4d-e7378ea083d2

	measure 'Fatia das minhas horas' = DIVIDE ( [Horas na biblioteca], CALCULATE ( [Horas na biblioteca], ALL ( game_costs ) ) )
		formatString: 0.0%
		lineageTag: a428d86e-6acb-44ce-8d43-a1c254163414

	measure 'Frase de cada 10' =
			VAR x = [Fatia das minhas horas] * 10
			VAR r = ROUND ( x, 0 )
			RETURN IF ( r = 0, "menos de 1 de cada 10", IF ( x < r, "quase ", IF ( x > r, "pouco mais de ", "" ) ) & r & " de cada 10" )
		lineageTag: 5b207d26-f883-46ff-8ad7-0e5bccf1ba70

	measure Jogador = SELECTEDVALUE ( game_costs[nickname], "Jogador" ) & " na Steam"
		lineageTag: d3394b47-a53e-4195-9593-a524a56d0a6a

	measure 'Atualizado em' = "Atualizado em " & FORMAT ( CALCULATE ( MAX ( game_costs[last_snapshot_date] ), ALL ( game_costs ) ), "dd/mm/yyyy" )
		lineageTag: 3b772884-ff5a-4734-906a-062a9e0e2e03

	measure 'Nome do jogo' = SELECTEDVALUE ( game_costs[name], "" )
		lineageTag: 318597af-5f9f-4f12-80b6-5074d2c62e5b

	measure 'Arte do jogo' = SELECTEDVALUE ( game_costs[hero_url], SELECTEDVALUE ( game_costs[header_image_url] ) )
		lineageTag: 9da84e10-70b5-43e3-ba08-aa7b9e23d1b7
		dataCategory: ImageUrl

	measure 'Título do gasto no jogo' = IF ( SELECTEDVALUE ( game_costs[value_origin] ) IN { "gratuito", "sem compra na Steam" }, "Gastei dentro dele", "Gastei no jogo e extras" )
		lineageTag: 26b2dee4-3bbe-4056-a12b-7b61161a93f9

	measure 'Gasto no jogo texto' = VAR v = SUM ( game_costs[total_spend_brl] ) RETURN IF ( ISBLANK ( v ), "sem preço", "R$" & UNICHAR ( 160 ) & FORMAT ( v, "#,0.00" ) )
		lineageTag: 35471a04-8df7-4c15-98f4-c1af9db2b352

	measure 'Frase da origem curta' =
			VAR o = SELECTEDVALUE ( game_costs[value_origin] )
			RETURN SWITCH ( o, "gratuito", "o jogo é gratuito", "sem compra na Steam", "veio sem compra na Steam", "origem: " & o )
		lineageTag: ac6b0835-9d04-43fd-9b73-107e49095160

	measure 'Jogos com 100 h ou mais' = CALCULATE ( COUNTROWS ( game_costs ), game_costs[minutes_played] >= 6000 ) + 0
		formatString: 0
		lineageTag: d288a280-b59e-4028-bff3-1ad1c254d31b

	measure 'Jogos com 500 h ou mais' = CALCULATE ( COUNTROWS ( game_costs ), game_costs[minutes_played] >= 30000 ) + 0
		formatString: 0
		lineageTag: 624a79f5-bb42-400a-ac6b-2eb1da022355

	measure 'Frase do pódio' = VAR resto = CALCULATE ( COUNTROWS ( game_costs ), ALL ( game_costs ) ) - 6 RETURN "Os outros " & resto & " jogos dividem os " & FORMAT ( 1 - [Fatia dos seis mais jogados], "0%" ) & " restantes."
		lineageTag: c2c68160-2ffa-4968-a3ba-5dd6561bb68d

	measure 'Frase de contraste' =
			VAR elegiveis = FILTER ( game_costs, game_costs[hours_group] = "jogado" && game_costs[value_origin] IN { "pago", "estimado" } )
			VAR barato = TOPN ( 1, elegiveis, game_costs[cost_per_hour_brl], ASC )
			VAR caro = TOPN ( 1, elegiveis, game_costs[cost_per_hour_brl], DESC )
			VAR razao = INT ( DIVIDE ( MAXX ( caro, game_costs[cost_per_hour_brl] ), MAXX ( barato, game_costs[cost_per_hour_brl] ) ) )
			RETURN IF ( razao >= 2, MAXX ( caro, game_costs[name] ) & " foi o mais caro. Uma hora dele custou o mesmo que " & razao & " horas do primeiro da lista.", "" )
		lineageTag: a580067a-36b8-4c5b-b88f-3b000bfe7fd4

	/// Selo de custo-benefício (regra 28): Platina até R$ 0,50/h, Ouro até R$ 1, Prata até R$ 3, Bronze acima
	measure Selo =
			VAR custo = SELECTEDVALUE ( game_costs[cost_per_hour_brl] )
			VAR elegivel = SELECTEDVALUE ( game_costs[hours_group] ) = "jogado" && SELECTEDVALUE ( game_costs[value_origin] ) IN { "pago", "estimado" }
			RETURN IF ( NOT elegivel || ISBLANK ( custo ), "sem selo",
			    SWITCH ( TRUE (), custo <= 0.5, "Platina", custo <= 1, "Ouro", custo <= 3, "Prata", "Bronze" ) )
		lineageTag: 3398d5f5-4043-45b8-a184-f6a9784851f5

	measure 'Cor do selo' = SWITCH ( [Selo], "Platina", "#8FD8FF", "Ouro", "#FFC24B", "Prata", "#C3CCD6", "Bronze", "#E0A27A", "#B1BAC4" )
		lineageTag: e1d6c539-f9a0-498d-8799-7e4cc1368099

	measure 'Fundo do selo' = SWITCH ( [Selo], "Platina", "#2C3D4A", "Ouro", "#403929", "Prata", "#353B42", "Bronze", "#3A3332", "#161B22" )
		lineageTag: a8deaf61-cc4d-4980-9d2e-b500c385c671

	measure 'Origens do grupo' = CONCATENATEX ( VALUES ( game_costs[value_origin] ), game_costs[value_origin], ", ", game_costs[value_origin], ASC )
		lineageTag: 37336f53-96f4-4d4b-a3d2-263584c60c21

	measure 'Custo por hora do grupo' = VAR v = DIVIDE ( SUM ( game_costs[total_spend_brl] ), [Horas na biblioteca] ) RETURN IF ( ISBLANK ( v ), "sem preço", "R$" & UNICHAR ( 160 ) & FORMAT ( v, "#,0.00" ) )
		lineageTag: dfc95d11-ef1c-42f3-bd06-1418bc94c669

	measure 'Manchete das metades' =
			VAR hNao = CALCULATE ( [Horas na biblioteca], game_costs[cost_group] = "sem comprar" )
			VAR gNao = CALCULATE ( SUM ( game_costs[total_spend_brl] ), game_costs[cost_group] = "sem comprar" ) + 0
			VAR p = DIVIDE ( hNao, [Horas na biblioteca] )
			RETURN IF ( ISFILTERED ( game_costs[value_origin] ), "Placar com o filtro escolhido",
			    IF ( ABS ( p - 0.5 ) <= 0.03, "Metade das minhas horas", FORMAT ( p, "0%" ) & " das minhas horas" ) & " me custou " & "R$" & UNICHAR ( 160 ) & FORMAT ( gNao, "#,0.00" ) )
		lineageTag: 2bf27f58-418d-4cab-b35a-0128c244f543

	measure 'Frase da outra metade' =
			VAR hSim = CALCULATE ( [Horas na biblioteca], game_costs[cost_group] = "comprei" )
			VAR gSim = CALCULATE ( SUM ( game_costs[total_spend_brl] ), game_costs[cost_group] = "comprei" ) + 0
			VAR p = DIVIDE ( hSim, [Horas na biblioteca] )
			RETURN IF ( ISFILTERED ( game_costs[value_origin] ), "",
			    IF ( ABS ( p - 0.5 ) <= 0.03, "A outra metade foi em jogos pagos e custou ", "Os outros " & FORMAT ( p, "0%" ) & " foram em jogos pagos e custaram " ) & "R$" & UNICHAR ( 160 ) & FORMAT ( gSim, "#,0.00" ) & "." )
		lineageTag: fd37b28b-44bf-415e-984c-06e126cca229

	measure 'Mal começados texto' = "R$" & UNICHAR ( 160 ) & FORMAT ( [Valor em jogos mal começados] + 0, "#,0.00" )
		lineageTag: 0de0c6f3-81d1-457c-93d2-4ad4f32c6bbb

	measure 'Nomes dos mal começados' =
			VAR jogos = FILTER ( game_costs, game_costs[hours_group] = "mal começado" && game_costs[value_origin] IN { "pago", "estimado" } )
			VAR n = COUNTROWS ( jogos ) + 0
			VAR primeiros = TOPN ( 2, jogos, game_costs[minutes_played], ASC, game_costs[name], ASC )
			VAR lista = CONCATENATEX ( primeiros, game_costs[name] & " (" & game_costs[minutes_played] & " min)", IF ( n > 2, ", ", " e " ), game_costs[minutes_played], ASC )
			RETURN SWITCH ( TRUE (), n = 0, "Nenhum jogo nesse grupo", n <= 2, lista, lista & " e mais " & ( n - 2 ) & IF ( n - 2 = 1, " jogo", " jogos" ) )
		lineageTag: 9fd96fe7-dafa-4990-bab0-9a52aea5d45f

	measure 'Dinheiro parado texto' = "R$" & UNICHAR ( 160 ) & FORMAT ( [Dinheiro parado] + 0, "#,0.00" )
		lineageTag: 8954af9f-232e-412a-a407-274a3aeb3d0e

	measure 'Jogos pagos nunca abertos' = CALCULATE ( COUNTROWS ( game_costs ), game_costs[hours_group] = "não jogado", game_costs[value_origin] IN { "pago", "estimado" } ) + 0
		formatString: 0
		lineageTag: dede7d7c-7e5f-4939-ab2a-aa9769fd8ca5

	measure 'Frase do dinheiro parado' =
			VAR n = [Jogos pagos nunca abertos]
			RETURN IF ( n = 0, "Nenhum jogo ficou parado", n & IF ( n = 1, " jogo esperando", " jogos esperando" ) & " na estante" )
		lineageTag: 5b59d579-4704-433f-86cd-9934f0b1ef57

	measure 'Texto do botão da ficha' = IF ( HASONEVALUE ( game_costs[name] ), "Abrir ficha do jogo", "Clique num jogo" )
		lineageTag: 6078e5ac-0d2e-4aea-8682-a0d3ce8d8240

	measure 'Anos desde a primeira compra' =
			VAR primeira = CALCULATE ( MIN ( purchase_discounts[purchase_date] ), ALL ( purchase_discounts ) )
			VAR ultima = CALCULATE ( MAX ( game_costs[last_snapshot_date] ), ALL ( game_costs ) )
			RETURN INT ( DIVIDE ( DATEDIFF ( primeira, ultima, DAY ), 365.25 ) )
		formatString: 0
		lineageTag: bba5f275-1dff-44ed-bf68-ab87fc4e3e40

	/// Posição pelo total de horas; o ALL ignora o filtro do drill-through
	measure 'Posição em horas' =
			VAR meu = SUM ( game_costs[minutes_played] )
			RETURN COUNTROWS ( FILTER ( ALL ( game_costs ), game_costs[minutes_played] > meu ) ) + 1
		formatString: 0
		lineageTag: ea7dcdbc-f504-44de-ae1e-a25687d52bcd

	measure 'Posição texto' = [Posição em horas] & "º"
		lineageTag: b5ecf01a-edec-43e1-bffb-37934f029bbf

	measure 'Paguei texto' = VAR v = SUM ( game_costs[game_value_brl] ) RETURN IF ( ISBLANK ( v ), "sem preço", "R$" & UNICHAR ( 160 ) & FORMAT ( v, "#,0.00" ) )
		lineageTag: c92d2c67-0254-4027-b09f-e39ceb3c2f46

	measure 'Extras texto' = "R$" & UNICHAR ( 160 ) & FORMAT ( SUM ( game_costs[extra_spend_brl] ) + 0, "#,0.00" )
		lineageTag: ddd777b4-be6b-4772-82d9-aae320eb6e40

	measure 'Frase da compra' = VAR d = MIN ( game_costs[first_purchase_date] ) RETURN IF ( ISBLANK ( d ), "não comprei na Steam", "em " & FORMAT ( d, "dd/mm/yyyy" ) )
		lineageTag: bbc69b9c-b678-464a-9ce8-f41024bd221e

	measure 'Frase do selo' =
			VAR s = [Selo]
			VAR o = SELECTEDVALUE ( game_costs[value_origin] )
			VAR m = SUM ( game_costs[minutes_played] )
			RETURN IF ( s = "sem selo",
			    SWITCH ( TRUE (),
			        o = "sem valor conhecido", "Sem selo, porque não sei quanto o jogo custou",
			        NOT ( o IN { "pago", "estimado" } ), "Sem selo, porque não comprei na Steam",
			        m = 0, "Sem selo, porque ainda não abri o jogo",
			        "Sem selo, porque joguei menos de 1 hora" ),
			    "Selo " & s & ", com " & [Custo por hora do jogo] & " por hora" )
		lineageTag: 762ce81c-0505-47d5-a5de-3ed36a3eee11

	measure 'Frase de origem' =
			VAR d = MIN ( game_costs[first_purchase_date] )
			RETURN SWITCH ( SELECTEDVALUE ( game_costs[value_origin] ),
			    "pago", IF ( ISBLANK ( d ), "Comprei na Steam.", "Comprei na Steam em " & FORMAT ( d, "dd/mm/yyyy" ) & "." ),
			    "gratuito", "Jogo grátis para jogar.",
			    "sem compra na Steam", "Entrou sem compra na Steam, por presente, cortesia, promoção grátis ou chave de outra loja.",
			    "estimado", "Valor estimado pelo preço cheio da loja.",
			    "Sem preço conhecido na loja." )
		lineageTag: ba31a79b-0795-48a1-bbd3-c91b49974140

	measure 'Curiosidades do jogo' =
			VAR fatia = FORMAT ( [Fatia das minhas horas], "0.0%" )
			VAR o = SELECTEDVALUE ( game_costs[value_origin] )
			VAR valor = SUM ( game_costs[game_value_brl] )
			VAR extras = SUM ( game_costs[extra_spend_brl] )
			VAR minutos = SUM ( game_costs[minutes_played] )
			VAR pos = [Posição em horas]
			VAR p1 = SWITCH ( TRUE (),
			    minutos = 0, "Ainda não abri este jogo.",
			    minutos < 60, "Joguei só " & minutos & IF ( minutos = 1, " minuto.", " minutos." ),
			    pos = 1, "É o jogo que mais joguei, com " & fatia & " das minhas horas.",
			    "É o meu " & pos & "º jogo mais jogado, com " & fatia & " das minhas horas." )
			VAR p2 = SWITCH ( TRUE (),
			    o IN { "gratuito", "sem compra na Steam" } && extras > 0, " Não paguei para jogar, mas gastei " & "R$" & UNICHAR ( 160 ) & FORMAT ( extras, "#,0.00" ) & " dentro dele.",
			    valor > 0 && extras > valor, " Dentro dele, gastei " & FORMAT ( DIVIDE ( extras, valor ), "0.0" ) & " vezes o que paguei pelo jogo.",
			    "" )
			RETURN p1 & p2
		lineageTag: 0501caf6-e089-404a-937b-6cda7d1e9f4e

	measure 'Título do card horas' = "Total de horas jogadas na Steam, durante " & [Anos desde a primeira compra] & " anos (cerca de " & FORMAT ( [Horas por dia de conta], "0.0" ) & " h por dia)"
		lineageTag: 1fde3c55-0a43-4726-8786-fbc87e91d613

	measure 'Título do card jogos' =
			VAR pagos = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "pago" ) + 0
			VAR gratis = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "gratuito" ) + 0
			VAR semCompra = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "sem compra na Steam" ) + 0
			VAR outros = [Jogos na conta] - pagos - gratis - semCompra
			RETURN "Jogos na minha conta. Comprei " & pagos & ", " & gratis & " são grátis e " & semCompra & " vieram sem compra na Steam"
			    & IF ( outros > 0, ". " & outros & " têm valor estimado ou desconhecido", "" )
		lineageTag: b4bbc294-8d35-44c0-81e8-de3ed90d4cf5

	measure 'Título do card gasto' = IF ( [Tem estimado], "Gastei na Steam, somando o pago, o estimado e o que comprei dentro dos jogos", "Gastei na Steam, somando os jogos e o que comprei dentro deles" )
		lineageTag: a879c4ce-9068-462f-8837-1a7f1d42b377

	measure 'Título do card média' = IF ( [Tem estimado], "Cada hora de jogo me custou, em média", "Cada hora de jogo pago me custou, em média" )
		lineageTag: 66e9f935-e12a-46d2-8bbd-68ee9efd7953

	measure 'Título do coração horas' = "Horas com o jogo aberto, segundo a Steam"
		lineageTag: e6f62b50-95c5-4072-8031-4d611f0ed2b9

	measure 'Título do coração fatia' = "Das minhas horas jogadas, ele corresponde a:"
		lineageTag: 3a846b4a-a121-40ad-be92-c042632e40ee

	measure 'Título do coração gasto' = "Quanto gastei com ele:"
		lineageTag: 06477ab5-1227-4741-a50c-a9be35ae28aa

	measure 'Fatia das horas sem custo' = DIVIDE ( CALCULATE ( [Horas na biblioteca], game_costs[cost_group] = "sem comprar" ), [Horas na biblioteca] )
		formatString: 0.0%
		lineageTag: b9c8de75-fbab-47b4-a8fa-15815e9a3eba

	measure 'Fato extra título' =
			VAR topo = TOPN ( 1, game_costs, game_costs[extra_spend_brl], DESC )
			VAR preco = MAXX ( topo, game_costs[game_value_brl] ) + 0
			RETURN "Gastei dentro do " & MAXX ( topo, game_costs[name] ) & IF ( preco = 0, ", um jogo que não me custou nada", ", um jogo que me custou " & "R$" & UNICHAR ( 160 ) & FORMAT ( preco, "#,0.00" ) )
		lineageTag: f467b01a-57a5-495d-8676-3ad8efaf5514

	measure 'Fato extra valor' = "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( TOPN ( 1, game_costs, game_costs[extra_spend_brl], DESC ), game_costs[extra_spend_brl] ) + 0, "#,0.00" )
		lineageTag: 3444b754-a9f5-4f3a-82dd-ed1c5175d5a7

	measure 'Título dos mal começados' =
			VAR jogos = FILTER ( game_costs, game_costs[hours_group] = "mal começado" && game_costs[value_origin] IN { "pago", "estimado" } )
			VAR n = COUNTROWS ( jogos ) + 0
			VAR lista = CONCATENATEX ( jogos, game_costs[minutes_played] & " min de " & game_costs[name], " e ", game_costs[minutes_played], ASC )
			RETURN SWITCH ( TRUE (),
			    n = 0, "Nenhum jogo que comprei ficou com menos de 1 hora",
			    n = 1, "Comprei 1 jogo que mal abri. Joguei " & lista,
			    n = 2, "Comprei 2 jogos que mal abri. Joguei " & lista,
			    "Comprei " & n & " jogos que joguei menos de 1 hora" )
		lineageTag: 645c47bb-5a56-4bfc-a88a-ba39ee7857b7

	measure 'Título do dinheiro parado' = VAR n = [Jogos pagos nunca abertos] RETURN IF ( n = 0, "Todo jogo que comprei, eu abri pelo menos uma vez", "Tenho " & n & IF ( n = 1, " jogo comprado que nunca abri", " jogos comprados que nunca abri" ) )
		lineageTag: a59ca83c-7858-456b-80c2-139cb856164a

	measure 'Título nível' = IF ( CALCULATE ( COUNTROWS ( game_costs ), game_costs[purchase_history_loaded] = TRUE () ) > 0, "Histórico de compras que carreguei", "Sem histórico de compras, uso o preço da loja" )
		lineageTag: b90fd693-bdbe-4ec2-ad68-a4b73815f3a0

	measure 'Gastei no grupo' = SUM ( game_costs[total_spend_brl] ) + 0
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 70d47edf-289e-4fa8-8ebf-8952c18c7bbd

	/// Average hours per day since the first purchase (account age), up to the last snapshot.
	measure 'Horas por dia de conta' =
			VAR primeira = CALCULATE ( MIN ( purchase_discounts[purchase_date] ), ALL ( purchase_discounts ) )
			VAR ultima = CALCULATE ( MAX ( game_costs[last_snapshot_date] ), ALL ( game_costs ) )
			RETURN DIVIDE ( [Horas na biblioteca], DATEDIFF ( primeira, ultima, DAY ) )
		formatString: 0.0
		lineageTag: dffea637-3fde-424b-a24b-5901bee1a58f

	measure 'Título do card paguei' = VAR d = MIN ( game_costs[first_purchase_date] ) RETURN IF ( ISBLANK ( d ), "Paguei pelo jogo", "Paguei pelo jogo em " & FORMAT ( d, "dd/mm/yyyy" ) )
		lineageTag: a0fd3aa8-768c-404a-abc0-873255c9b668

	measure 'Título do card posição' = "Posição entre os meus " & CALCULATE ( COUNTROWS ( game_costs ), ALL ( game_costs ) ) & " jogos"
		lineageTag: 10b43df3-afbb-4ae6-a15a-dfebb856dffc

	measure 'Fatia dos seis mais jogados' = DIVIDE ( SUMX ( TOPN ( 6, ALL ( game_costs ), game_costs[minutes_played], DESC ), game_costs[minutes_played] ), CALCULATE ( SUM ( game_costs[minutes_played] ), ALL ( game_costs ) ) )
		formatString: 0%
		lineageTag: 44d96998-48ec-46b7-a93d-f25b3b79c458

	measure 'Título do pódio' = "Seis jogos somam " & FORMAT ( [Fatia dos seis mais jogados], "0%" ) & " das minhas horas"
		lineageTag: 22d180a3-831f-49ab-b4a9-a2123c8cc8cb

	measure 'Fato poucas horas título' = "Jogos que joguei menos de 10 horas"
		lineageTag: 2c695f02-2774-4bd2-981e-9478c838019d

	measure 'Fato poucas horas valor' = VAR n = CALCULATE ( COUNTROWS ( game_costs ), game_costs[minutes_played] < 600 ) + 0 RETURN n & " de " & [Jogos na conta]
		lineageTag: 562500ac-cf7d-45df-90fd-2d07378147fc

	measure 'Título fato grátis' =
			VAR p = [Fatia das horas sem custo]
			VAR inicio = SWITCH ( TRUE (),
			    ABS ( p - 0.5 ) < 0.005, "Metade das minhas horas foi",
			    p >= 0.45 && p < 0.5, "Quase metade das minhas horas foi",
			    p > 0.5 && p <= 0.55, "Pouco mais da metade das minhas horas foi",
			    FORMAT ( p, "0%" ) & " das minhas horas foram" )
			RETURN inicio & " em jogos que não paguei para jogar"
		lineageTag: dbc001e9-c67f-4948-97e7-fb811e709ff1

	measure 'Fato dentro título' =
			VAR r = ROUND ( DIVIDE ( SUM ( game_costs[extra_spend_brl] ), [Gasto total] ) * 10, 0 )
			RETURN "De cada R$ 10 que gastei na Steam, " & SWITCH ( TRUE (), r < 1, "menos de R$ 1 foi", r = 1, "R$ 1 foi", "R$ " & r & " foram" ) & " dentro dos jogos"
		lineageTag: cce6e0bc-3169-44ee-8e76-1d480a8659ad

	measure 'Fato dentro valor' = "R$" & UNICHAR ( 160 ) & FORMAT ( SUM ( game_costs[extra_spend_brl] ) + 0, "#,0.00" )
		lineageTag: 103eb215-5bc4-4a6a-b572-b7733046326c

	measure 'Fato 100 horas título' = VAR n500 = [Jogos com 500 h ou mais] RETURN "Passei de 100 horas nestes jogos" & IF ( n500 > 0, ". Em " & n500 & " deles, passei de 500", "" )
		lineageTag: d1b05d87-865c-4926-8d2e-45360cc2a7bb

	measure 'Fato 100 horas valor' = VAR n = [Jogos com 100 h ou mais] RETURN n & IF ( n = 1, " jogo", " jogos" )
		lineageTag: a9feaced-4602-4b1e-835d-c520f7611111

	measure 'Dinheiro parado valor' = IF ( [Jogos pagos nunca abertos] = 0, "nenhum parado", [Dinheiro parado texto] )
		lineageTag: 5d6a6a61-bf1f-4828-b575-7cb53122f168

	measure 'Horas da origem' = [Horas na biblioteca] + 0
		formatString: #,0" h"
		lineageTag: 31efd734-d1a9-459d-a44f-041d49dd9a38

	measure 'Como consegui' = SWITCH ( SELECTEDVALUE ( game_costs[value_origin] ), "pago", "comprei", "gratuito", "grátis para jogar", "sem compra na Steam", "sem comprar na Steam", "estimado", "valor estimado", "sem preço conhecido" )
		lineageTag: 3a6be3bc-c721-4de4-a103-30ef3007a25e

