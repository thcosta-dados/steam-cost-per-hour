/// Cost per hour of each game (view public.game_costs). Labels translated to Portuguese in Power Query.
table game_costs
	lineageTag: bf85bb68-cd73-478d-90cb-92bdadf5e71a

	/// Value of licensed games never opened (spec, rule 9). Unknown values are blank and ignored by SUM (rule 18).
	measure 'Dinheiro parado' = CALCULATE ( SUM ( game_costs[game_value_brl] ), game_costs[hours_group] = "não jogado" )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: c893c9ba-a6dc-4117-bd3e-c2e8cbfc3175

	/// Value of games played for less than 1 hour (spec, rule 10).
	measure 'Valor em jogos mal começados' = CALCULATE ( SUM ( game_costs[game_value_brl] ), game_costs[hours_group] = "mal começado" )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: bb0eb698-c498-4d92-8c07-8347ed7083ed

	/// Licensed games without a purchase record or store price: out of the ranking and sums (spec, rule 18).
	measure 'Jogos sem valor conhecido' = CALCULATE ( COUNTROWS ( game_costs ), game_costs[value_origin] = "sem valor conhecido" ) + 0
		formatString: 0
		lineageTag: dda9c777-cd73-48f8-a136-4deb179ae698

	/// Everything spent on Steam on games: game value + extra spending (DLCs, in-game purchases).
	measure 'Gasto total' = SUM ( game_costs[total_spend_brl] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: ba5bd1de-441c-47d7-9717-3c033faeee87

	/// Spending on games bought (value + extra), to compare with games without access cost.
	measure 'Gasto em jogos pagos' = CALCULATE ( SUM ( game_costs[total_spend_brl] ), game_costs[value_origin] = "pago" )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 1056a96a-de8c-4ac0-9192-bf821b44467e

	/// Money spent inside free games and games received without purchase (spec, rule 16).
	measure 'Gasto em jogos sem custo de acesso' = CALCULATE ( SUM ( game_costs[extra_spend_brl] ), game_costs[value_origin] IN { "gratuito", "sem compra na Steam" } )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: cb7cd97b-d6b8-41ab-becc-83c9f45733b1

	/// Which level the data is at: complete (purchase history loaded) or basic (only the SteamID).
	measure 'Nível dos dados' = IF ( CALCULATE ( COUNTROWS ( game_costs ), game_costs[purchase_history_loaded] = TRUE () ) > 0, "Completo", "Básico" )
		lineageTag: 7808bca7-2f54-417f-b85a-80e801db9111

	/// Date of the purchase that is the game value, as text: games without a Steam purchase show "sem compra".
	measure 'Data da compra' = VAR purchase_date = MIN ( game_costs[first_purchase_date] ) RETURN IF ( ISBLANK ( purchase_date ), "sem compra", FORMAT ( purchase_date, "dd/mm/yyyy" ) )
		lineageTag: dc1e6edb-cdaa-4664-ae15-65bb109bc5b1

	/// Cost per hour of one game, as text: "—" when it is not calculated (0 hours or unknown value, rules 9 and 18).
	measure 'Custo por hora do jogo' = VAR cost = SUM ( game_costs[cost_per_hour_brl] ) RETURN IF ( ISBLANK ( cost ), "—", FORMAT ( cost, "\R$ #,0.00" ) )
		lineageTag: 44d9e389-c6b4-49ae-9e18-94d7665ad96a

	/// Ranking title with its takeaway: the paid game with 1 hour or more that cost least per hour (follows the filters).
	measure 'Título do ranking' = VAR best = TOPN ( 1, FILTER ( game_costs, game_costs[hours_group] = "jogado" && game_costs[value_origin] IN { "pago", "estimado" } ), game_costs[cost_per_hour_brl], ASC ) RETURN IF ( ISEMPTY ( best ), "Jogos pagos com 1 hora ou mais: nenhum jogo com os filtros atuais", "Jogos pagos com 1 hora ou mais. Mais barato por hora: " & MAXX ( best, game_costs[name] ) & ", " & FORMAT ( MAXX ( best, game_costs[cost_per_hour_brl] ), "\R$ #,0.00" ) )
		lineageTag: b61f6b94-9e76-4eb6-a7f9-0f6a3af06d76

	/// Spec rule 25: total spending on paid (or estimated) games divided by their hours, 0 h games included.
	measure 'Custo médio por hora (jogos pagos)' = DIVIDE ( CALCULATE ( SUM ( game_costs[total_spend_brl] ), game_costs[value_origin] IN { "pago", "estimado" } ), CALCULATE ( SUM ( game_costs[minutes_played] ), game_costs[value_origin] IN { "pago", "estimado" } ) / 60 )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 74ae5d52-239c-4fff-95ba-e1e870917b40

	/// Money parked with the number of games, so "R$ 0,00" does not look like an error.
	measure 'Dinheiro parado com contagem' = VAR games = CALCULATE ( COUNTROWS ( game_costs ), game_costs[hours_group] = "não jogado", game_costs[game_value_brl] > 0 ) + 0 RETURN FORMAT ( [Dinheiro parado] + 0, "\R$ #,0.00" ) & " · " & games & IF ( games = 1, " jogo", " jogos" )
		lineageTag: e1829d89-db9e-4003-a67b-db2c7acfd067

	/// Value of paid games played for less than 1 hour, with the number of games.
	measure 'Mal começados com contagem' = VAR games = CALCULATE ( COUNTROWS ( game_costs ), game_costs[hours_group] = "mal começado", game_costs[game_value_brl] > 0 ) + 0 RETURN FORMAT ( [Valor em jogos mal começados] + 0, "\R$ #,0.00" ) & " · " & games & IF ( games = 1, " jogo", " jogos" )
		lineageTag: b0caad86-a7b6-4d0f-b5e8-2cd2b0c904aa

	/// Context line of the home page: total spending, what cost per hour means and the last collection.
	measure 'Contexto do início' = "Gasto total na Steam: " & FORMAT ( [Gasto total], "\R$ #,0.00" ) & "   ·   Custo por hora = (valor do jogo + gasto extra) ÷ horas jogadas   ·   Última coleta: " & FORMAT ( MAX ( game_costs[last_snapshot_date] ), "dd/mm/yyyy" )
		lineageTag: 655deefc-5b8c-4f9e-a357-10dc6e3a7094

