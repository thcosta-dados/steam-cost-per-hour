	partition game_costs = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(DatabaseServer, DatabaseName),
				    GameCosts = Source{[Schema = "public", Item = "game_costs"]}[Data],
				    // Portuguese labels for the dashboard; the database keeps the English codes
				    OriginLabels = [paid = "pago", free = "gratuito", no_purchase = "sem compra na Steam", estimated = "estimado", unknown = "sem valor conhecido"],
				    GroupLabels = [played = "jogado", barely_started = "mal começado", not_played = "não jogado"],
				    Labeled = Table.TransformColumns(GameCosts, {
				        {"value_origin", each Record.FieldOrDefault(OriginLabels, _, _), type text},
				        {"hours_group", each Record.FieldOrDefault(GroupLabels, _, _), type text}
				    }),
				    // Money as fixed decimal (Currency.Type): exact, like NUMERIC in the database
				    Typed = Table.TransformColumnTypes(Labeled, {
				        {"app_id", Int64.Type}, {"minutes_played", Int64.Type}, {"last_snapshot_date", type date},
				        {"hours_played", type number}, {"game_value_brl", Currency.Type}, {"cost_per_hour_brl", Currency.Type},
				        {"extra_spend_brl", Currency.Type}, {"total_spend_brl", Currency.Type}, {"purchase_history_loaded", type logical},
				        {"first_purchase_date", type date}
				    }),
				    // Ticket 11b: groups in plain words and links to the Steam artwork of each game
				    CostGroup = Table.AddColumn(Typed, "cost_group", each if List.Contains({"pago", "estimado"}, [value_origin]) then "comprei" else if List.Contains({"gratuito", "sem compra na Steam"}, [value_origin]) then "sem comprar" else "sem preço conhecido", type text),
				    HoursLabel = Table.AddColumn(CostGroup, "hours_group_label", each if [hours_group] = "jogado" then "1 hora ou mais" else if [hours_group] = "mal começado" then "menos de 1 hora" else "nunca abri", type text),
				    HoursOrder = Table.AddColumn(HoursLabel, "hours_group_order", each if [hours_group] = "jogado" then 1 else if [hours_group] = "mal começado" then 2 else 3, Int64.Type),
				    Hero = Table.AddColumn(HoursOrder, "hero_url", each "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/" & Text.From([app_id]) & "/library_hero.jpg", type text),
				    Portrait = Table.AddColumn(Hero, "portrait_url", each "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/" & Text.From([app_id]) & "/library_600x900.jpg", type text)
				in
				    Portrait

	annotation PBI_ResultType = Table

