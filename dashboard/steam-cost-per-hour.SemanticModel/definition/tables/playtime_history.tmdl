/// Total hours of each game on each collection day (view public.playtime_history): the evolution in the game detail page.
table playtime_history
	lineageTag: e3d92472-1265-4bea-ac36-7922cda54464

	measure 'Horas totais' = SUM ( playtime_history[hours_played] )
		formatString: #,0.0
		lineageTag: 9b1d41de-1a40-4ba5-a14f-ddad2b8a2371

	measure 'Frase da evolução' =
			VAR primeiro = MIN ( playtime_history[snapshot_date] )
			VAR ultimo = MAX ( playtime_history[snapshot_date] )
			VAR h0 = CALCULATE ( SUM ( playtime_history[hours_played] ), playtime_history[snapshot_date] = primeiro )
			VAR h1 = CALCULATE ( SUM ( playtime_history[hours_played] ), playtime_history[snapshot_date] = ultimo )
			RETURN IF ( h1 - h0 <= 0, "Não abri este jogo desde " & FORMAT ( primeiro, "dd/mm/yyyy" ) & ".",
			    "Desde " & FORMAT ( primeiro, "dd/mm/yyyy" ) & ", joguei mais " & FORMAT ( h1 - h0, "#,0.0" ) & " h nele." )
		lineageTag: d08b5f88-6566-4d33-bc53-9b8565a90518

	column user_id
		dataType: string
		isHidden
		lineageTag: 60ceb6f3-d911-44d7-ae14-aa9e8f84c007
		summarizeBy: none
		sourceColumn: user_id

	column app_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d9902efb-70e8-4b4e-a664-dfd344b6435b
		summarizeBy: none
		sourceColumn: app_id

	column snapshot_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 06a6222d-a731-4b6f-ae84-fed6d79a7e10
		summarizeBy: none
		sourceColumn: snapshot_date

		annotation UnderlyingDateTimeDataType = Date

	column minutes_played
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: b6384fd3-5f16-4a1f-984c-b83cadf2f4f6
		summarizeBy: none
		sourceColumn: minutes_played

	column hours_played
		dataType: double
		formatString: #,0.00
		lineageTag: fd4c8c31-fc64-4718-9cc4-3d747a40e117
		summarizeBy: none
		sourceColumn: hours_played

	/// Same key as game_costs[game_key]: the relationship that filters the history of one game.
	column game_key
		dataType: string
		isHidden
		lineageTag: 586707c2-62cb-48bc-8ad0-cdce57adf21e
		summarizeBy: none
		sourceColumn: game_key

	/// Collection day as dd/MM/yy for the chart axis, sorted by the date
	column snapshot_label
		dataType: string
		lineageTag: be77a735-e5d8-4d39-92c4-9b3bd1bada4c
		summarizeBy: none
		sourceColumn: snapshot_label
		sortByColumn: snapshot_date

	partition playtime_history = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(DatabaseServer, DatabaseName),
				    History = Source{[Schema = "public", Item = "playtime_history"]}[Data],
				    Typed = Table.TransformColumnTypes(History, {
				        {"app_id", Int64.Type}, {"snapshot_date", type date},
				        {"minutes_played", Int64.Type}, {"hours_played", type number}
				    }),
				    // Short label for the chart axis, like collection_days[day_label]
				    SnapshotLabel = Table.AddColumn(Typed, "snapshot_label", each Date.ToText([snapshot_date], "dd/MM/yy"), type text)
				in
				    SnapshotLabel

	annotation PBI_ResultType = Table

