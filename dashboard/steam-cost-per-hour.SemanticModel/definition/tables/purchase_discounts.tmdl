/// Discount of each purchase against the price at purchase time (view public.purchase_discounts, spec rule 21).
table purchase_discounts
	lineageTag: eb4ea62a-3cd3-4647-95d3-70255ff638b7

	measure 'Economia com descontos' = SUM ( purchase_discounts[savings_brl] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: e488c8dc-1bc6-4012-9b4a-f88e50a3029d

	/// Share of the original prices that was saved: savings / original prices.
	measure 'Desconto médio' = DIVIDE ( SUM ( purchase_discounts[savings_brl] ), SUM ( purchase_discounts[original_price_brl] ) )
		formatString: 0.0%
		lineageTag: 34c530e9-0a11-481d-b496-1a3343f302c6

	/// Total paid in the purchases of the table (games and DLCs; refunded purchases left out).
	measure 'Pago nas compras' = SUM ( purchase_discounts[paid_brl] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: ab893814-cc1b-4130-ad76-7211243eebb2

	measure 'Frase do preço cheio' = "o preço cheio seria " & "R$" & UNICHAR ( 160 ) & FORMAT ( SUM ( purchase_discounts[original_price_brl] ) + 0, "#,0.00" )
		lineageTag: 5497ee31-3023-48ec-8fdb-9aaa82f96652

	measure 'Frase das compras com desconto' = FORMAT ( DIVIDE ( CALCULATE ( COUNTROWS ( purchase_discounts ), purchase_discounts[discount_pct] > 0 ), COUNTROWS ( purchase_discounts ) ), "0%" ) & " das compras tiveram desconto"
		lineageTag: d0bbd4d0-a3d1-407e-beae-0e8663e11e1b

	measure 'Mês com mais compras' =
			VAR meses = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_month] ), "@n", CALCULATE ( COUNTROWS ( purchase_discounts ) ) )
			VAR topo = TOPN ( 1, meses, [@n], DESC, purchase_discounts[purchase_month], ASC )
			RETURN IF ( ISEMPTY ( meses ), "nenhum", FORMAT ( DATE ( 2000, MAXX ( topo, purchase_discounts[purchase_month] ), 1 ), "mmmm" ) )
		lineageTag: 55ceb2f6-d784-4e78-b015-a592476cd93f

	measure 'Frase do mês' =
			VAR meses = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_month] ), "@n", CALCULATE ( COUNTROWS ( purchase_discounts ) ) )
			RETURN MAXX ( meses, [@n] ) & " compras, somando todos os anos"
		lineageTag: 19379846-1cef-41f9-b32a-4c3881bb2371

	measure 'Título do gráfico de anos' =
			VAR anos = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_year] ), "@pago", CALCULATE ( SUM ( purchase_discounts[paid_brl] ) ) )
			VAR topo = TOPN ( 1, anos, [@pago], DESC )
			RETURN IF ( ISEMPTY ( anos ), "Nenhuma compra no período",
			    MAXX ( topo, purchase_discounts[purchase_year] ) & " foi o ano em que mais gastei: " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( topo, [@pago] ), "#,0.00" ) )
		lineageTag: e21b4952-26f3-4aa8-85f4-37d60963068a

	measure 'Subtítulo do gráfico de anos' =
			VAR anos = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_year] ),
			    "@n", CALCULATE ( COUNTROWS ( purchase_discounts ) ),
			    "@pago", CALCULATE ( SUM ( purchase_discounts[paid_brl] ) ),
			    "@eco", CALCULATE ( SUM ( purchase_discounts[savings_brl] ) ) )
			VAR mais = TOPN ( 1, anos, [@n], DESC, purchase_discounts[purchase_year], DESC )
			VAR nMais = MAXX ( mais, [@n] )
			VAR eco = FILTER ( anos, [@eco] > [@pago] )
			VAR n = COUNTROWS ( eco ) + 0
			VAR ultimo = MAXX ( eco, purchase_discounts[purchase_year] )
			VAR lista = IF ( n <= 1, ultimo & "", CONCATENATEX ( FILTER ( eco, purchase_discounts[purchase_year] < ultimo ), purchase_discounts[purchase_year], ", ", purchase_discounts[purchase_year], ASC ) & " e " & ultimo )
			RETURN IF ( ISEMPTY ( anos ), "",
			    "Fiz mais compras em " & MAXX ( mais, purchase_discounts[purchase_year] ) & IF ( nMais = 1, ", foi 1.", ", foram " & nMais & "." )
			    & IF ( n = 0, "", " Em " & lista & ", economizei mais do que paguei." ) )
		lineageTag: 0d2b4679-12c5-4179-8d4b-b6707b10ff91

	measure 'Primeira compra título' = IF ( ISFILTERED ( purchase_discounts[purchase_date] ), "Primeira compra do período", "Minha primeira compra" )
		lineageTag: 84399a7c-3a7b-4348-9ef2-05768c92930a

	measure 'Primeira compra data' = VAR d = MIN ( purchase_discounts[purchase_date] ) RETURN IF ( ISBLANK ( d ), "nenhuma", FORMAT ( d, "dd/mm/yyyy" ) )
		lineageTag: 0257a2ad-ff0c-4c54-bd92-b4174dfca778

	measure 'Primeira compra frase' =
			VAR d = MIN ( purchase_discounts[purchase_date] )
			VAR linha = TOPN ( 1, FILTER ( purchase_discounts, purchase_discounts[purchase_date] = d ), purchase_discounts[paid_brl], DESC )
			RETURN IF ( ISBLANK ( d ), "Nenhuma compra no período", MAXX ( linha, purchase_discounts[items_short] ) & ", por " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( linha, purchase_discounts[paid_brl] ), "#,0.00" ) )
		lineageTag: d486575d-737c-4568-938f-6f9cd32f6e71

	measure 'Compra mais cara texto' = "R$" & UNICHAR ( 160 ) & FORMAT ( MAX ( purchase_discounts[paid_brl] ) + 0, "#,0.00" )
		lineageTag: 133ad230-ff6b-434f-b7c6-9c3309b020d4

	measure 'Compra mais cara frase' =
			VAR linha = TOPN ( 1, purchase_discounts, purchase_discounts[paid_brl], DESC, purchase_discounts[purchase_date], ASC )
			RETURN IF ( ISEMPTY ( linha ), "Nenhuma compra no período", MAXX ( linha, purchase_discounts[items_short] ) & ", em " & FORMAT ( MAXX ( linha, purchase_discounts[purchase_date] ), "dd/mm/yyyy" ) )
		lineageTag: 34170291-a74b-4488-943e-252cdcd4589b

	measure 'Maior desconto texto' = FORMAT ( MAX ( purchase_discounts[discount_pct] ) + 0, "0" ) & "%"
		lineageTag: 37a2cb2b-de2e-40bc-9008-0fad7224f6e4

	measure 'Maior desconto frase' =
			VAR linha = TOPN ( 1, purchase_discounts, purchase_discounts[discount_pct], DESC, purchase_discounts[savings_brl], DESC )
			RETURN IF ( ISEMPTY ( linha ), "Nenhuma compra no período",
			    MAXX ( linha, purchase_discounts[items_short] ) & ": " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( linha, purchase_discounts[paid_brl] ), "#,0.00" ) & " em vez de " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( linha, purchase_discounts[original_price_brl] ), "#,0.00" ) )
		lineageTag: 184ef584-9519-4af7-943f-c3dd7726b2c9

	measure 'Maior economia texto' = "R$" & UNICHAR ( 160 ) & FORMAT ( MAX ( purchase_discounts[savings_brl] ) + 0, "#,0.00" )
		lineageTag: d1cef71f-035f-4e7b-96cc-123acac85165

	measure 'Maior economia frase' =
			VAR linha = TOPN ( 1, purchase_discounts, purchase_discounts[savings_brl], DESC )
			RETURN IF ( ISEMPTY ( linha ), "Nenhuma compra no período", MAXX ( linha, purchase_discounts[items_short] ) & ", com " & MAXX ( linha, purchase_discounts[discount_pct] ) & "% de desconto" )
		lineageTag: 7ba2f6e4-f39e-4864-9eeb-159eba0c979e

	measure 'Fato desde título' =
			VAR d = CALCULATE ( MIN ( purchase_discounts[purchase_date] ), ALL ( purchase_discounts ) )
			VAR jogo = MAXX ( TOPN ( 1, FILTER ( ALL ( purchase_discounts ), purchase_discounts[purchase_date] = d ), purchase_discounts[paid_brl], DESC ), purchase_discounts[items_short] )
			RETURN "Estou na Steam desde " & FORMAT ( d, "dd/mm/yyyy" ) & ", quando comprei " & jogo
		lineageTag: b7269701-469a-4412-8262-af19cd55fba4

	measure 'Fato desde valor' = [Anos desde a primeira compra] & " anos"
		lineageTag: 3c32f1d5-c196-48d9-9125-5a820d4ad572

	measure 'Fato economia título' = "Economizei com promoções, pagando " & "R$" & UNICHAR ( 160 ) & FORMAT ( SUM ( purchase_discounts[paid_brl] ) + 0, "#,0.00" ) & " em vez de " & "R$" & UNICHAR ( 160 ) & FORMAT ( SUM ( purchase_discounts[original_price_brl] ) + 0, "#,0.00" )
		lineageTag: e3fa388e-d5f2-47ed-9dbe-b443b501b2d5

	measure 'Fato pechincha título' =
			VAR linha = TOPN ( 1, purchase_discounts, purchase_discounts[discount_pct], DESC, purchase_discounts[savings_brl], DESC )
			RETURN "Paguei " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( linha, purchase_discounts[paid_brl] ), "#,0.00" ) & " no " & MAXX ( linha, purchase_discounts[items_short] ) & ", que custava " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( linha, purchase_discounts[original_price_brl] ), "#,0.00" )
		lineageTag: bee8e610-652c-41cd-a729-daba3e5ba2a8

	measure 'Fato ano título' =
			VAR anos = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_year] ), "@pago", CALCULATE ( SUM ( purchase_discounts[paid_brl] ) ), "@n", CALCULATE ( COUNTROWS ( purchase_discounts ) ) )
			VAR topo = TOPN ( 1, anos, [@pago], DESC )
			RETURN "O ano em que mais gastei: " & "R$" & UNICHAR ( 160 ) & FORMAT ( MAXX ( topo, [@pago] ), "#,0.00" ) & " em " & MAXX ( topo, [@n] ) & " compras"
		lineageTag: 5c890092-e0a2-4d80-830e-7a8a576c357f

	measure 'Fato ano valor' =
			VAR anos = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_year] ), "@pago", CALCULATE ( SUM ( purchase_discounts[paid_brl] ) ) )
			RETURN FORMAT ( MAXX ( TOPN ( 1, anos, [@pago], DESC ), purchase_discounts[purchase_year] ), "0" )
		lineageTag: 8c08ffe4-57fd-42db-9d15-ba08fef52b13

	measure 'Título economia' = "Economizei com promoções. Sem elas, teria pago " & "R$" & UNICHAR ( 160 ) & FORMAT ( SUM ( purchase_discounts[original_price_brl] ) + 0, "#,0.00" )
		lineageTag: 1eb9f22f-48d2-4fef-8bdc-e7681d02b4c5

	measure 'Título desconto médio' = "Desconto médio que consegui. " & FORMAT ( DIVIDE ( CALCULATE ( COUNTROWS ( purchase_discounts ), purchase_discounts[discount_pct] > 0 ), COUNTROWS ( purchase_discounts ) ), "0%" ) & " das compras foram em promoção"
		lineageTag: 0facdd06-ff1b-48d2-a7ee-f8160b0cd269

	measure 'Título do mês' =
			VAR meses = ADDCOLUMNS ( VALUES ( purchase_discounts[purchase_month] ), "@n", CALCULATE ( COUNTROWS ( purchase_discounts ) ) )
			RETURN "Somando todos os anos, é o mês em que mais compro. Foram " & MAXX ( meses, [@n] ) & " compras"
		lineageTag: 26296f3d-687d-488a-ab76-a0ae0ba61e0f

	measure 'Título primeira compra' = IF ( ISBLANK ( MIN ( purchase_discounts[purchase_date] ) ), "Nenhuma compra no período", IF ( ISFILTERED ( purchase_discounts[purchase_date] ), "A primeira compra do período foi ", "Comecei na Steam com " ) & [Primeira compra frase] )
		lineageTag: b0b4e80b-cf77-4d26-8ad3-1d718093a808

	measure 'Título compra mais cara' =
			VAR linha = TOPN ( 1, purchase_discounts, purchase_discounts[paid_brl], DESC, purchase_discounts[purchase_date], ASC )
			RETURN IF ( ISEMPTY ( linha ), "Nenhuma compra no período", MAXX ( linha, purchase_discounts[items_short] ) & " foi a compra mais cara, em " & FORMAT ( MAXX ( linha, purchase_discounts[purchase_date] ), "dd/mm/yyyy" ) )
		lineageTag: e72cb14a-7fe0-47b1-ad37-daf3878fd8ce

	measure 'Título maior desconto' = "O maior desconto: " & [Maior desconto frase]
		lineageTag: 60b78bb5-5d8a-41cf-b6d0-564acffdf1db

	measure 'Título maior economia' =
			VAR linha = TOPN ( 1, purchase_discounts, purchase_discounts[savings_brl], DESC )
			RETURN IF ( ISEMPTY ( linha ), "Nenhuma compra no período", "Minha maior economia foi no " & MAXX ( linha, purchase_discounts[items_short] ) & ", com " & MAXX ( linha, purchase_discounts[discount_pct] ) & "% de desconto" )
		lineageTag: 0435fcb2-ad97-40ae-aa0d-eb8ecde7355e

	measure 'Paguei no ano' = SUM ( purchase_discounts[paid_brl] ) + 0
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 74d9db06-b443-4a17-82ab-ba0ea363b548

	measure 'Economizei no ano' = SUM ( purchase_discounts[savings_brl] ) + 0
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: efb78054-fd85-424f-aee6-04d639c43573

	measure 'Título compras pela metade' = "Compras em que paguei metade do preço ou menos"
		lineageTag: ee005151-2d6c-4e04-a45c-b70eb082e1e8

	measure 'Compras pela metade valor' = VAR n = CALCULATE ( COUNTROWS ( purchase_discounts ), purchase_discounts[discount_pct] >= 50 ) + 0 RETURN n & " de " & ( COUNTROWS ( purchase_discounts ) + 0 )
		lineageTag: de0dfaf2-2e5c-4a9c-95b9-4e3a14209429

	measure 'Fato pechincha valor' = FORMAT ( MAX ( purchase_discounts[discount_pct] ) + 0, "0" ) & "% de desconto"
		lineageTag: c272ef80-b22d-4864-a438-f3d05b4793ed

	column user_id
		dataType: string
		isHidden
		lineageTag: 31282cee-db3c-44d8-8178-b08fd2d68c54
		summarizeBy: none
		sourceColumn: user_id

	column purchase_key
		dataType: string
		isHidden
		lineageTag: 92c3894f-16b7-4dfc-8849-b3a6eb59314b
		summarizeBy: none
		sourceColumn: purchase_key

	column purchase_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3a3667e7-dcb7-4053-aa28-704216b6fc53
		summarizeBy: none
		sourceColumn: purchase_date

		annotation UnderlyingDateTimeDataType = Date

	column items
		dataType: string
		lineageTag: be2ab510-445d-4f1e-a1de-9da978033bc3
		summarizeBy: none
		sourceColumn: items

	column paid_brl
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: 851348ef-9305-4738-bafe-e2a3a64b0683
		summarizeBy: none
		sourceColumn: paid_brl

	column original_price_brl
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: a400c776-3d3e-4f62-967f-a08347abf7b1
		summarizeBy: none
		sourceColumn: original_price_brl

	column discount_pct
		dataType: int64
		formatString: 0"%"
		lineageTag: ffd3bfa0-0d06-40b6-a95b-c6e2be284a4d
		summarizeBy: none
		sourceColumn: discount_pct

	column savings_brl
		dataType: decimal
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		lineageTag: dc2887e3-d1ef-4b92-8b76-632d0a1d24d0
		summarizeBy: none
		sourceColumn: savings_brl

	/// Year of the purchase (Power Query), for the chart of paid and saved values per year.
	column purchase_year
		dataType: int64
		formatString: 0
		lineageTag: 3211005f-6ffb-4c3f-9cf4-d6e2e381c2cd
		summarizeBy: none
		sourceColumn: purchase_year

	column purchase_month
		dataType: int64
		formatString: 0
		lineageTag: a42c8d30-f1f6-46df-91d3-d2037376b6cb
		summarizeBy: none
		sourceColumn: purchase_month

	/// Itens da compra com pacote encurtado
	column items_short
		dataType: string
		lineageTag: 64a18aa8-7c49-40b9-822f-8e7a33501343
		summarizeBy: none
		sourceColumn: items_short

	partition purchase_discounts = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(DatabaseServer, DatabaseName),
				    Discounts = Source{[Schema = "public", Item = "purchase_discounts"]}[Data],
				    Typed = Table.TransformColumnTypes(Discounts, {
				        {"purchase_date", type date}, {"paid_brl", Currency.Type}, {"original_price_brl", Currency.Type},
				        {"discount_pct", Int64.Type}, {"savings_brl", Currency.Type}
				    }),
				    WithYear = Table.AddColumn(Typed, "purchase_year", each Date.Year([purchase_date]), Int64.Type),
				    WithMonth = Table.AddColumn(WithYear, "purchase_month", each Date.Month([purchase_date]), Int64.Type),
				    // Bundles become "Item A e mais 1 item", so the sentence fits
				    WithShort = Table.AddColumn(WithMonth, "items_short", each let p = Text.Split(Text.Remove([items], {"™", "®"}), " + "), n = List.Count(p) in if n = 1 then p{0} else p{0} & " e mais " & Text.From(n - 1) & (if n = 2 then " item" else " itens"), type text)
				in
				    WithShort

	annotation PBI_ResultType = Table

